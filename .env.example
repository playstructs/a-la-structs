# À la Structs live mode finds each guild's services from the guild's own
# published config (on-chain record → endpoint → services), so nothing here is
# required. Uncomment to override.

# Guild preselected in the picker.
# VITE_GUILD_ID=0-1

# Chain REST (LCD) used to look up guild records and players.
# VITE_LCD_URL=https://public.testnet.structs.network

# Event stream. Used when the guild doesn't publish a wss:// one (or always,
# if set here). Default wss://beta.playstructs.com:1443; "off" disables.
# VITE_GRASS_URL=wss://beta.playstructs.com:1443
# VITE_RPC_URL=wss://public.testnet.structs.network:26657

# Relay GRASS through this dev server (if the browser can't reach it directly).
# GRASS_URL=ws://crew.oh.energy:1443

# Older same-origin mode: proxy /api to one guild and skip the picker.
# GUILD_URL=http://crew.oh.energy

# Guild chat (Matrix). Normally discovered; set if the guild's config doesn't say.
# VITE_MATRIX_HOMESERVER=https://matrix.example.org
# VITE_MATRIX_ROOM=#general:example.org

# Public URL of the deployed site (canonical, og:url, sitemap). Set for production builds.
# VITE_SITE_URL=https://your-domain.example/
