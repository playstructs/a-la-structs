# Where your Structs guild lives. The dev server proxies these so the game
# core talks to them from this origin (session cookies, no CORS).

# Guild webapp (serves /api). The structs-webapp docker container defaults to :8080.
GUILD_URL=http://localhost:8080

# GRASS event stream (NATS over WebSocket). Leave unset to use ws://<this host>:1443 directly.
# GRASS_URL=ws://localhost:1443

# Chain RPC websocket used for signing. Leave unset to use ws://<this host>:26657 directly.
# RPC_URL=ws://localhost:26657

# Optional town-square relay for presence + group chat (npm run hangout).
# VITE_HANGOUT_URL=ws://localhost:8787
